{
  "name": "combirumbo-chiclayo",
  "version": "0.1.0",
  "description": "PWA para ayudar a pasajeros de Chiclayo a encontrar qué transporte tomar, dónde subir y dónde bajar",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:data": "node scripts/compile-data.js",
    "prebuild": "node scripts/compile-data.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "25.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
